{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@NewsFlow/api": "workspace:*",
    "@NewsFlow/auth": "workspace:*",
    "@NewsFlow/db": "workspace:*",
    "@NewsFlow/env": "workspace:*",
    "@NewsFlow/queue": "workspace:*",
    "@orpc/openapi": "^1.13.5",
    "@orpc/server": "^1.13.5",
    "@orpc/zod": "^1.13.5",
    "better-auth": "^1.4.18",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@NewsFlow/config": "workspace:*",
    "@types/bun": "^1.3.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3"
  }
}
