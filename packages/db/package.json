    "pg": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@NewsFlow/config": "workspace:*",
    "@types/pg": "^8.16.0",
    "prisma": "^7.4.0",
    "typescript": "^5.9.3"
