model FeedSource {
  id            String             @id @default(cuid())
  url           String
  normalizedUrl String             @unique
  siteUrl       String?
  title         String
  description   String?
  iconUrl       String?
  language      String?
  lastFetched   DateTime?
  // Job tracking fields
  lastError     String? // Last RSS fetch error message
  errorCount    Int                @default(0) // Consecutive error count
  nextFetchAt   DateTime? // Scheduled next fetch time
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  subscriptions FeedSubscription[]
  articles      SourceArticle[]

  @@index([nextFetchAt]) // Index for scheduled jobs
  @@map("feed_source")
}

model FeedSubscription {
  id           String      @id @default(cuid())
  userId       String
  feedSourceId String
  customTitle  String?
  category     String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedSource   FeedSource  @relation(fields: [feedSourceId], references: [id], onDelete: Cascade)

  @@unique([userId, feedSourceId])
  @@index([userId])
  @@index([feedSourceId])
  @@index([isActive])
  @@map("feed_subscription")
}

model SourceArticle {
  id                  String             @id @default(cuid())
  feedSourceId        String
  articleKey          String
  guid                String?
  title               String
  link                String
  author              String?
  pubDate             DateTime
  content             String?
  excerpt             String?
  image               String?
  categories          String[]
  contentExtracted    Boolean            @default(false)
  // Content extraction tracking
  extractionAttempts  Int                @default(0) // Number of extraction attempts
  lastExtractionError String? // Last extraction error
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  feedSource          FeedSource         @relation(fields: [feedSourceId], references: [id], onDelete: Cascade)
  userStates          UserArticleState[]

  @@unique([feedSourceId, articleKey])
  @@index([feedSourceId, pubDate(sort: Desc)])
  @@index([contentExtracted]) // Index for extraction jobs
  @@map("source_article")
}

model UserArticleState {
  id              String       @id @default(cuid())
  userId          String
  sourceArticleId String
  read            Boolean      @default(false)
  saved           Boolean      @default(false)
  readAt          DateTime?
  savedAt         DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceArticle   SourceArticle @relation(fields: [sourceArticleId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceArticleId])
  @@index([userId])
  @@index([sourceArticleId])
  @@index([read])
  @@index([saved])
  @@map("user_article_state")
}

model AiConfig {
  id        String   @id @default(cuid())
  userId    String
  name      String
  provider  String
  model     String
  apiKey    String
  baseUrl   String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ai_config")
}

model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  model     String
  tokens    Int      @default(0)
  action    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_usage")
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  tier                 String    @default("free")
  status               String    @default("active")
  billingInterval      String?
  stripePriceId        String?
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  canceledAt           DateTime?
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tier])
  @@index([status])
  @@index([stripePriceId])

  @@map("subscription")
}
